{
    "name": "hydro-workspace",
    "private": true,
    "workspaces": [
        "packages/*",
        "framework/*",
        "plugins/*",
        "modules/*",
        "examples/plugins/*"
    ],
    "main": "package.json",
    "scripts": {
        "build": "node build/prepare.js && tsc -b --verbose",
        "build:installer": "esbuild ./install/install.js --minify --format=cjs --bundle --platform=node --external:readline/promises | gzip -9 | base64",
        "build:watch": "node build/prepare.js && tsc -b --watch",
        "build:ui": "node packages/ui-default/build --iconfont && node packages/ui-default/build",
        "build:ui:iconfont": "node packages/ui-default/build --iconfont",
        "build:ui:dev": "node packages/ui-default/build --iconfont && node --trace-deprecation packages/ui-default/build --dev",
        "build:ui:dev:https": "node packages/ui-default/build --iconfont && node --trace-deprecation packages/ui-default/build --dev --https",
        "build:ui:production": "cross-env-shell NODE_OPTIONS=--max_old_space_size=8192 \"node packages/ui-default/build --iconfont && node packages/ui-default/build --production\"",
        "build:ui:production:webpack": "cross-env NODE_OPTIONS=--max_old_space_size=8192 node packages/ui-default/build --production",
        "build:ui-next": "tsc -p tsconfig.ui-next.json --noEmit && yarn workspace @hydrooj/ui-next vite build",
        "test": "yarn test:unit && node test/entry.js",
        "benchmark": "cross-env BENCHMARK=true node test/entry.js",
        "oxlint": "cd framework/eslint-config && node -r @hydrooj/register build.ts && cd ../../ && oxlint --config framework/eslint-config/.oxlintrc.json",
        "lint": "eslint packages plugins modules framework --ext .ts,.tsx,.jsx,.vue,.yaml,.yml --fix",
        "lint:ci": "eslint packages plugins modules framework --ext .ts,.tsx,.jsx,.vue,.yaml,.yml --max-warnings=0",
        "debug": "node --trace-warnings --async-stack-traces --trace-deprecation packages/hydrooj/bin/hydrooj --debug --template",
        "start": "packages/hydrooj/bin/hydrooj.js",
        "postinstall": "node build/prepare.js",
        "gen-patch": "node -r @hydrooj/register build/gen-patch.ts",
        "hydrooj": "./node_modules/.bin/hydrooj",
        "test:unit": "node --import ./test/register-typescript.mjs --test framework/framework/tests/*.spec.ts packages/common/tests/*.spec.ts packages/code-replay/tests/*.spec.ts packages/honor-frame/tests/*.spec.ts packages/client-updates/tests/*.spec.ts packages/user-contributions/tests/*.spec.ts packages/editor-paste-guard/tests/*.spec.ts packages/contest-enhancements/tests/*.spec.ts packages/private-messages/tests/*.spec.ts packages/hydrojudge/tests/*.spec.ts packages/hydrooj/tests/*.spec.ts packages/ui-next/tests/*.spec.ts"
    },
    "version": "1.0.0",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/autocannon": "^7.12.7",
        "@types/chai": "^5.2.3",
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "24.13.3",
        "@types/semver": "^7.8.0",
        "autocannon": "^8.0.0",
        "cac": "^7.1.0",
        "chai": "^6.3.0",
        "cross-env": "^10.1.0",
        "cross-spawn": "^7.0.6",
        "esbuild": "0.25.2",
        "eslint": "^10.12.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-import-resolver-webpack": "^0.13.11",
        "fs-extra": "^11.4.1",
        "globals": "^17.13.0",
        "globby": "~14.0.2",
        "inspectpack": "^4.7.1",
        "mongodb-memory-server": "11.0.1",
        "nyc": "^18.0.0",
        "ora": "^9.4.1",
        "oxlint": "^1.88.0",
        "package-json": "^10.0.1",
        "semver": "^7.8.5",
        "simple-git": "^4.0.2",
        "supertest": "^7.3.1",
        "supports-hyperlinks": "^4.6.0",
        "typescript": "6.0.3",
        "wtfnode": "^0.10.1"
    },
    "resolutions": {
        "mongodb": "^7.0.0",
        "@types/express-serve-static-core": "patch:@types/express-serve-static-core@npm%3A4.19.6#~/.yarn/patches/@types-express-serve-static-core-npm-4.19.6-cc0017aaf4.patch",
        "markdown-it": "14.3.0",
        "@mantine/core": "9.4.1",
        "@mantine/hooks": "9.4.1",
        "@mantine/notifications": "9.4.1"
    },
    "packageManager": "yarn@4.17.0+sha512.c2957de2f9025ab14d63b24d0d8be1f1655810e22c341042c27f7ecd017b180ec12db73d69ac366d71b304ef9f069349ce462de96f04f8f1da317f4f762c95ae"
}
